generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  FINANCE
  CLIENT
}

enum TripStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum QuoteItemCategory {
  FLIGHT
  HOTEL
  TRANSFER
  TOUR
  INSURANCE
  OTHER
}

enum ReservationServiceStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InstallmentStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum TravelDocumentType {
  TRAVEL_VOUCHER
  PURCHASE_RECEIPT
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String
  refreshTokenHash          String?
  role                      UserRole
  isActive                  Boolean   @default(true)
  failedLoginAttempts       Int       @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  mfaEnabled                Boolean   @default(false)
  mfaSecretEncrypted        String?
  mfaPendingSecretEncrypted String?
  mfaEnrolledAt             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  client            Client?
  authSessions      AuthSession[]
  mfaRecoveryCodes  MfaRecoveryCode[]
  authAuditEvents   AuthAuditEvent[]
  issuedDocuments   TravelDocument[]

  @@index([role, isActive])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgentHash    String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthAuditEvent {
  id            String   @id @default(cuid())
  userId        String?
  eventType     String
  emailHash     String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Client {
  id          String   @id @default(cuid())
  userId      String?  @unique
  fullName    String
  email       String?  @unique
  phone       String?
  birthDate   DateTime?
  document    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  companions   Companion[]
  reservations Reservation[]

  @@index([fullName])
  @@index([birthDate])
}

model Companion {
  id           String   @id @default(cuid())
  clientId     String
  fullName     String
  document     String?
  birthDate    DateTime?
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([birthDate])
}

model Trip {
  id            String     @id @default(cuid())
  title         String
  origin        String
  destination   String
  departureDate DateTime
  returnDate    DateTime?
  status        TripStatus @default(DRAFT)
  capacity      Int?
  busTemplate   String?
  seatLayout    String?
  priceCents    Int?
  summary       String?
  imageUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  reservations    Reservation[]
  seatAssignments SeatAssignment[]

  @@index([origin, destination, departureDate])
  @@index([status, departureDate])
}

model Reservation {
  id        String            @id @default(cuid())
  clientId  String
  tripId    String
  status         ReservationStatus @default(PENDING)
  passengerCount Int               @default(1)
  accessCodeHash String?
  createdAt       DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  trip        Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  quotes      Quote[]
  services    ReservationService[]
  financePlan FinancePlan?
  documents       TravelDocument[]
  seatAssignments SeatAssignment[]

  @@unique([clientId, tripId])
  @@index([tripId, status])
}

model SeatAssignment {
  id            String   @id @default(cuid())
  tripId        String
  reservationId String
  seatNumber    Int
  createdAt     DateTime @default(now())

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@unique([reservationId, seatNumber])
  @@index([reservationId])
}

model Quote {
  id                String      @id @default(cuid())
  reservationId     String
  revision          Int
  status            QuoteStatus @default(DRAFT)
  title             String
  validUntil        DateTime?
  notes             String?
  subtotalCostCents Int         @default(0)
  subtotalSaleCents Int         @default(0)
  discountCents     Int         @default(0)
  totalCents        Int         @default(0)
  marginCents       Int         @default(0)
  sentAt            DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items       QuoteItem[]
  financePlan FinancePlan?

  @@unique([reservationId, revision])
  @@index([reservationId, status])
}

model QuoteItem {
  id             String            @id @default(cuid())
  quoteId        String
  category       QuoteItemCategory
  description    String
  supplier       String?
  quantity       Int               @default(1)
  unitCostCents  Int               @default(0)
  unitSaleCents  Int               @default(0)
  totalCostCents Int               @default(0)
  totalSaleCents Int               @default(0)
  createdAt      DateTime          @default(now())

  quote              Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  reservationService ReservationService?

  @@index([quoteId, category])
}

model ReservationService {
  id                String                   @id @default(cuid())
  reservationId     String
  sourceQuoteItemId String?                  @unique
  category          QuoteItemCategory
  description       String
  supplier          String?
  amountCents       Int
  status            ReservationServiceStatus @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sourceQuoteItem QuoteItem?  @relation(fields: [sourceQuoteItemId], references: [id], onDelete: SetNull)

  @@index([reservationId, status])
}

model FinancePlan {
  id                String   @id @default(cuid())
  reservationId     String   @unique
  quoteId           String   @unique
  totalCents        Int
  downPaymentCents  Int      @default(0)
  installmentCount  Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  installments Installment[]
}

model Installment {
  id            String            @id @default(cuid())
  financePlanId String
  sequence      Int
  dueDate       DateTime
  amountCents   Int
  status        InstallmentStatus @default(OPEN)
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  financePlan FinancePlan @relation(fields: [financePlanId], references: [id], onDelete: Cascade)

  @@unique([financePlanId, sequence])
  @@index([status, dueDate])
}

model TravelDocument {
  id               String             @id @default(cuid())
  reservationId    String
  type             TravelDocumentType
  version          Int
  documentNumber   String             @unique
  verificationCode String             @unique
  snapshot         Json
  issuedByUserId   String?
  issuedAt         DateTime           @default(now())
  createdAt        DateTime           @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  issuedBy    User?       @relation(fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([reservationId, type, version])
  @@index([reservationId, type, issuedAt])
}
