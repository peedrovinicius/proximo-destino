generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  FINANCE
  CLIENT
}

enum TripStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum QuoteItemCategory {
  FLIGHT
  HOTEL
  TRANSFER
  TOUR
  INSURANCE
  OTHER
}

enum ReservationServiceStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InstallmentStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PurchasePaymentMethod {
  PIX
  CARD
  BOLETO
  TRANSFER
}

enum ManualPaymentMethod {
  CASH
  TRANSFER
  BOLETO
}

enum ManualPaymentStatus {
  RECEIVED
  REVERSED
}

enum TravelDocumentType {
  TRAVEL_VOUCHER
  PURCHASE_RECEIPT
}

enum BoardingStatus {
  PENDING
  BOARDED
  ABSENT
}

enum ClientCreditTransactionType {
  CANCELLATION_CREDIT
  BONUS_USED
  BONUS_REMOVED
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String
  refreshTokenHash          String?
  role                      UserRole
  isActive                  Boolean   @default(true)
  failedLoginAttempts       Int       @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  mfaEnabled                Boolean   @default(false)
  mfaSecretEncrypted        String?
  mfaPendingSecretEncrypted String?
  mfaEnrolledAt             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  client            Client?
  authSessions      AuthSession[]
  mfaRecoveryCodes  MfaRecoveryCode[]
  authAuditEvents   AuthAuditEvent[]
  issuedDocuments   TravelDocument[]
  paymentConnections PaymentProviderConnection[] @relation("PaymentConnectionOwner")
  emailConnections   EmailProviderConnection[]   @relation("EmailConnectionOwner")
  emailOauthStates    EmailOAuthState[]
  paymentOauthStates PaymentOAuthState[]
  creditTransactions ClientCreditTransaction[] @relation("CreditActor")
  notifications      AdminNotification[]
  recordedManualPayments ManualPayment[] @relation("ManualPaymentRecorder")
  reversedManualPayments ManualPayment[] @relation("ManualPaymentReverser")

  @@index([role, isActive])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgentHash    String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthAuditEvent {
  id            String   @id @default(cuid())
  userId        String?
  eventType     String
  emailHash     String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Client {
  id          String   @id @default(cuid())
  userId      String?  @unique
  fullName    String
  email       String?  @unique
  phone       String?
  birthDate   DateTime?
  document          String?
  documentEncrypted String?
  documentHash      String?
  notes             String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  companions   Companion[]
  reservations Reservation[]
  creditTransactions ClientCreditTransaction[]

  @@index([fullName])
  @@index([birthDate])
  @@index([documentHash])
}

model Companion {
  id           String   @id @default(cuid())
  clientId     String
  fullName     String
  document          String?
  documentEncrypted String?
  documentHash      String?
  birthDate         DateTime?
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([birthDate])
}

model Trip {
  id            String     @id @default(cuid())
  title         String
  origin        String
  destination   String
  departureDate DateTime
  returnDate    DateTime?
  status        TripStatus @default(DRAFT)
  capacity          Int?
  busTemplate       String?
  seatLayout        String?
  deckCount         Int?
  lowerDeckCapacity Int?
  vehicleFeatures   Json?
  blockedSeats      Int[]      @default([])
  priceCents        Int?
  summary       String?
  imageUrl      String?
  imageData     Bytes?
  imageMimeType String?
  imageUpdatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  reservations    Reservation[]
  seatAssignments SeatAssignment[]

  @@index([origin, destination, departureDate])
  @@index([status, departureDate])
}

model Reservation {
  id        String            @id @default(cuid())
  clientId  String
  tripId    String
  status         ReservationStatus @default(PENDING)
  passengerCount Int               @default(1)
  accessCodeHash String?
  cancellationRequestStatus CancellationRequestStatus?
  cancellationRequestedAt DateTime?
  cancellationRequestReason String?
  cancellationRequestResolvedAt DateTime?
  cancellationRequestResolutionNote String?
  cancellationRequestResolvedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  trip        Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  quotes      Quote[]
  services    ReservationService[]
  financePlan FinancePlan?
  purchaseOrder PurchaseOrder?
  documents       TravelDocument[]
  seatAssignments SeatAssignment[]
  passengers      ReservationPassenger[]
  creditTransactions ClientCreditTransaction[]
  manualPayments ManualPayment[]

  @@unique([clientId, tripId])
  @@index([tripId, status])
}

model ReservationPassenger {
  id            String   @id @default(cuid())
  reservationId String
  sequence      Int
  fullName      String?
  document          String?
  documentEncrypted String?
  documentHash      String?
  birthDate         DateTime?
  isPrimary     Boolean        @default(false)
  boardingStatus BoardingStatus @default(PENDING)
  boardedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  reservation  Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seatAssignment SeatAssignment?

  @@unique([reservationId, sequence])
  @@index([reservationId])
}

model SeatAssignment {
  id            String   @id @default(cuid())
  tripId        String
  reservationId String
  passengerId   String?  @unique
  seatNumber    Int
  createdAt     DateTime @default(now())

  trip        Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  reservation Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  passenger   ReservationPassenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)

  @@unique([tripId, seatNumber])
  @@unique([reservationId, seatNumber])
  @@index([reservationId])
}

model PurchaseOrder {
  id                String                @id @default(cuid())
  reservationId     String                @unique
  status            PurchaseStatus        @default(PENDING_PAYMENT)
  paymentMethod     PurchasePaymentMethod
  unitPriceCents    Int
  passengerCount    Int
  totalCents        Int
  providerPaymentId String?
  providerOrderId   String?
  providerStatus    String?
  paidAt            DateTime?
  refundedCents     Int                   @default(0)
  refundedAt        DateTime?
  lastReconciledAt  DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([providerPaymentId])
  @@index([providerOrderId])
}

model Quote {
  id                String      @id @default(cuid())
  reservationId     String
  revision          Int
  status            QuoteStatus @default(DRAFT)
  title             String
  validUntil        DateTime?
  notes             String?
  subtotalCostCents Int         @default(0)
  subtotalSaleCents Int         @default(0)
  discountCents     Int         @default(0)
  totalCents        Int         @default(0)
  marginCents       Int         @default(0)
  sentAt            DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items       QuoteItem[]
  financePlan FinancePlan?

  @@unique([reservationId, revision])
  @@index([reservationId, status])
}

model QuoteItem {
  id             String            @id @default(cuid())
  quoteId        String
  category       QuoteItemCategory
  description    String
  supplier       String?
  quantity       Int               @default(1)
  unitCostCents  Int               @default(0)
  unitSaleCents  Int               @default(0)
  totalCostCents Int               @default(0)
  totalSaleCents Int               @default(0)
  createdAt      DateTime          @default(now())

  quote              Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  reservationService ReservationService?

  @@index([quoteId, category])
}

model ReservationService {
  id                String                   @id @default(cuid())
  reservationId     String
  sourceQuoteItemId String?                  @unique
  category          QuoteItemCategory
  description       String
  supplier          String?
  amountCents       Int
  status            ReservationServiceStatus @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sourceQuoteItem QuoteItem?  @relation(fields: [sourceQuoteItemId], references: [id], onDelete: SetNull)

  @@index([reservationId, status])
}

model FinancePlan {
  id                String   @id @default(cuid())
  reservationId     String   @unique
  quoteId           String   @unique
  totalCents        Int
  downPaymentCents  Int      @default(0)
  installmentCount  Int
  refundedCents     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  installments Installment[]
  manualPayments ManualPayment[]
}

model Installment {
  id            String            @id @default(cuid())
  financePlanId String
  sequence      Int
  dueDate       DateTime
  amountCents   Int
  status        InstallmentStatus @default(OPEN)
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  financePlan FinancePlan @relation(fields: [financePlanId], references: [id], onDelete: Cascade)
  manualPayments ManualPayment[]

  @@unique([financePlanId, sequence])
  @@index([status, dueDate])
}

model TravelDocument {
  id               String             @id @default(cuid())
  reservationId    String
  type             TravelDocumentType
  version          Int
  documentNumber   String             @unique
  verificationCode String             @unique
  snapshot         Json
  issuedByUserId   String?
  issuedAt         DateTime           @default(now())
  createdAt        DateTime           @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  issuedBy    User?       @relation(fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([reservationId, type, version])
  @@index([reservationId, type, issuedAt])
}


model ClientCreditTransaction {
  id            String                      @id @default(cuid())
  clientId      String
  reservationId String?
  type          ClientCreditTransactionType
  amountCents   Int
  note          String?
  sourceKey     String?                     @unique
  actorUserId   String?
  createdAt     DateTime                    @default(now())

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  actor       User?        @relation("CreditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([reservationId])
}

model PaymentProviderConnection {
  id                    String   @id @default(cuid())
  provider              String   @unique
  externalUserId        String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  publicKey             String?
  scope                 String?
  liveMode              Boolean  @default(true)
  expiresAt             DateTime?
  connectedByUserId     String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connectedBy User? @relation("PaymentConnectionOwner", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([connectedByUserId])
}

model EmailProviderConnection {
  id                    String   @id @default(cuid())
  provider              String   @unique
  apiKeyEncrypted       String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  scope                 String?
  expiresAt             DateTime?
  fromName              String?
  fromEmail             String
  replyToEmail          String?
  adminCopyEmail        String?
  automationEnabled     Boolean  @default(false)
  connectedByUserId     String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connectedBy User? @relation("EmailConnectionOwner", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([connectedByUserId])
}

model EmailOAuthState {
  id                    String   @id @default(cuid())
  provider              String
  stateHash             String   @unique
  userId                String
  codeVerifierEncrypted String
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PaymentOAuthState {
  id        String   @id @default(cuid())
  provider  String
  stateHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}


model OutboundMessage {
  id                String                @id @default(cuid())
  channel           String                @default("WHATSAPP")
  eventType         String
  idempotencyKey    String                @unique
  recipientPhone    String
  recipientName     String?
  body              String
  templateName      String?
  templateLanguage  String?
  templateParams    Json?
  sourceType        String?
  sourceId          String?
  status            OutboundMessageStatus @default(PENDING)
  attempts          Int                   @default(0)
  scheduledAt       DateTime              @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, scheduledAt])
  @@index([eventType, createdAt])
  @@index([sourceType, sourceId])
}


model EmailOutboundMessage {
  id                String                @id @default(cuid())
  eventType         String
  idempotencyKey    String                @unique
  recipientEmail    String
  recipientName     String?
  adminCopyEmails   Json?
  subject           String
  textBody          String
  htmlBody          String?
  sourceType        String?
  sourceId          String?
  status            OutboundMessageStatus @default(PENDING)
  attempts          Int                   @default(0)
  scheduledAt       DateTime              @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, scheduledAt])
  @@index([eventType, createdAt])
  @@index([sourceType, sourceId])
}

model AdminNotification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  sourceKey  String
  actionTab  String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
}


model ManualPayment {
  id               String              @id @default(cuid())
  reservationId    String
  financePlanId    String?
  installmentId    String?
  method           ManualPaymentMethod
  status           ManualPaymentStatus @default(RECEIVED)
  amountCents      Int
  paidAt           DateTime
  reference        String?
  note             String?
  recordedByUserId String?
  reversedAt       DateTime?
  reversedReason   String?
  reversedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  financePlan FinancePlan? @relation(fields: [financePlanId], references: [id], onDelete: SetNull)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  recordedBy User? @relation("ManualPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  reversedBy User? @relation("ManualPaymentReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([reservationId, status, paidAt])
  @@index([installmentId, status])
  @@index([method, paidAt])
}
