NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proximo_destino?schema=public
FRONTEND_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-64-random-characters
JWT_MFA_SECRET=replace-with-a-third-independent-random-secret
AUDIT_HASH_KEY=replace-with-an-independent-random-secret

# Exatamente 32 bytes em base64. Ex.: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Somente para comandos operacionais locais/produção.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NEW_PASSWORD=replace-with-a-new-strong-password
ADMIN_RESET_MFA=false
