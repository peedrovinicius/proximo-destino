NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proximo_destino?schema=public
FRONTEND_ORIGIN=http://localhost:5173

# Gere segredos longos e independentes para cada ambiente.
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-64-random-characters

# Usadas apenas pelo comando npm run admin:create.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
